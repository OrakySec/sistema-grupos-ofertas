# ==============================================
# SISTEMA GRUPOS DE OFERTAS — .env.example
# Copie para .env e preencha os valores
# ==============================================

# --- Banco de dados ---
POSTGRES_USER=ofertas
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=ofertas
DATABASE_URL=postgresql://ofertas:TROQUE_ESTA_SENHA@postgres:5432/ofertas

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Autenticação do Painel (Admin) ---
ADMIN_EMAIL=orakysec@gmail.com
ADMIN_PASSWORD_HASH=GERADO_AUTOMATICAMENTE_NO_PRIMEIRO_BOOT
JWT_SECRET=TROQUE_PARA_STRING_ALEATORIA_LONGA

# --- Configurações da API ---
API_PORT=3001
NODE_ENV=production

# --- Mídia ---
MEDIA_BASE_PATH=/app/media
MEDIA_RETENTION_DAYS=30

# --- Telegram Listener (Python/Telethon) ---
# Estes também ficam no banco via painel Settings
# Mas podem ser pré-configurados aqui como fallback
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# --- URLs internas entre containers ---
INTERNAL_API_URL=http://api:3001
