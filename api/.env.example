# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ofertas_db"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Auth
ADMIN_EMAIL=admin@ofertas.local
# Generate with: node -e "const bcrypt=require('bcryptjs'); bcrypt.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$12$examplehashgoeshere

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Internal services
TELEGRAM_LISTENER_URL=http://telegram-listener:8000
