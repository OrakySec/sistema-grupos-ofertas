// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DestinationType {
  TELEGRAM
  WHATSAPP
}

enum MediaType {
  NONE
  PHOTO
  VIDEO
  DOCUMENT
}

enum OfferStatus {
  PENDING
  APPROVED
  REJECTED
  SENT
  FAILED
}

enum DeliveryStatus {
  SUCCESS
  FAILED
}

model SourceGroup {
  id         String   @id @default(cuid())
  // TELEGRAM = a real channel the listener reads. SHOPEE = the virtual source
  // behind a niche's automatic Shopee search (no Telegram chat behind it; it
  // exists so its offers reuse destinations, footer, health and analytics).
  kind       String   @default("TELEGRAM")
  telegramId BigInt   @unique
  name       String
  username   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Multiple SourceGroups can share one Niche (e.g. two Telegram channels
  // feeding the same public catalog/mockup/footer). Destination routing stays
  // per-SourceGroup regardless — see SourceGroupDestination below.
  nicheId String?
  niche   Niche?  @relation(fields: [nicheId], references: [id], onDelete: SetNull)

  offers       Offer[]
  destinations SourceGroupDestination[]
  shopeeHunter ShopeeHunter?
}

model Niche {
  id   String  @id @default(cuid())
  name String
  slug String? @unique // null = not yet exposed on the public offers site

  // null falls back to the global Setting of the same purpose. The 5 mockup*
  // fields are treated as an all-or-nothing group by the API (see
  // routes/niches.ts): either every one is set (custom template) or every one
  // is null (use the bundled default template + coordinates).
  footerText         String?  @db.Text
  mlOwnListUrl       String?
  mockupTemplatePath String?
  mockupBoxLeft      Int?
  mockupBoxTop       Int?
  mockupBoxRight     Int?
  mockupBoxBottom    Int?
  mockupCornerRadius Int?
  createdAt          DateTime @default(now())

  sourceGroups SourceGroup[]
  shopeeHunter ShopeeHunter?
}

model DestinationGroup {
  id        String          @id @default(cuid())
  name      String
  type      DestinationType
  chatId    String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  // Optional public invite link (WhatsApp groups only) — when set, the
  // worker's link-monitor job periodically checks it's still valid and
  // alerts the admin (via WhatsApp/Evolution API) when it expires/revokes.
  inviteLink         String?
  linkStatus         String?   @default("UNKNOWN") // VALID | INVALID | UNKNOWN
  linkLastCheckedAt  DateTime?
  linkLastNotifiedAt DateTime?

  // Short numeric id appended to our short links as ?g=<seq> when an offer is
  // sent to this group, so a click can be attributed to the group it came from.
  seq Int @unique @default(autoincrement())

  deliveryLogs   DeliveryLog[]
  sourceGroups   SourceGroupDestination[]
  waMembers      WaMember[]
  waMemberEvents WaMemberEvent[]
  waSnapshots    WaGroupSnapshot[]
}

model SourceGroupDestination {
  sourceGroupId      String
  destinationGroupId String

  sourceGroup      SourceGroup      @relation(fields: [sourceGroupId], references: [id], onDelete: Cascade)
  destinationGroup DestinationGroup @relation(fields: [destinationGroupId], references: [id], onDelete: Cascade)

  @@id([sourceGroupId, destinationGroupId])
}

model Offer {
  id                String      @id @default(cuid())
  sourceGroupId     String
  telegramMessageId BigInt
  text              String?     @db.Text
  mediaType         MediaType   @default(NONE)
  mediaLocalPath    String?
  mediaCaption      String?     @db.Text
  senderName        String?
  status            OfferStatus @default(PENDING)
  originalDate      DateTime
  createdAt         DateTime    @default(now())
  reviewedAt        DateTime?
  sentAt            DateTime?
  processingLog     Json?

  sourceGroup  SourceGroup   @relation(fields: [sourceGroupId], references: [id])
  deliveryLogs DeliveryLog[]

  @@unique([telegramMessageId, sourceGroupId])
}

model DeliveryLog {
  id                 String         @id @default(cuid())
  offerId            String
  destinationGroupId String
  status             DeliveryStatus
  errorMessage       String?
  sentAt             DateTime       @default(now())

  offer            Offer            @relation(fields: [offerId], references: [id])
  destinationGroup DestinationGroup @relation(fields: [destinationGroupId], references: [id])
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model ShortUrl {
  code        String   @id
  originalUrl String   @db.Text
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  clickLogs ShortUrlClick[]
}

model ShortUrlClick {
  id        String   @id @default(cuid())
  code      String
  createdAt DateTime @default(now())

  // Every request to /s/:code is logged, but only some are real people.
  // kind: HUMAN | BOT (link-preview fetchers, crawlers, HEAD checks) |
  // DUPLICATE (same visitor + link within a few minutes) | LEGACY (logged
  // before this classification existed — can't be told apart from bots).
  // Only HUMAN and LEGACY feed the "clicks" numbers in the panel.
  kind               String  @default("LEGACY")
  // Destination group the click came from (?g=<seq> on the short link);
  // null for links sent before per-group tagging existed.
  destinationGroupId String?
  agent              String? // short label, e.g. "WhatsApp", "Telegram", "Navegador"
  userAgent          String? @db.Text
  ipHash             String? // salted hash — never the raw IP

  shortUrl ShortUrl @relation(fields: [code], references: [code], onDelete: Cascade)

  @@index([createdAt])
  @@index([code, ipHash, createdAt])
  @@index([destinationGroupId, createdAt])
}

// ── WhatsApp group membership analytics ─────────────────────────────────────
// Fed by the Evolution API group-participants.update webhook (real time) and
// a periodic participant snapshot (fills gaps while the webhook was down).
// Members are identified by a salted hash of their WhatsApp id, never the raw
// phone number.

model WaMember {
  id                 String    @id @default(cuid())
  destinationGroupId String
  memberHash         String
  // When the current stint started; null = was already in the group when
  // tracking began (join date unknown, excluded from retention cohorts).
  joinedAt           DateTime?
  leftAt             DateTime? // null = currently in the group
  joinCount          Int       @default(0)
  updatedAt          DateTime  @updatedAt

  destinationGroup DestinationGroup @relation(fields: [destinationGroupId], references: [id], onDelete: Cascade)

  @@unique([destinationGroupId, memberHash])
  @@index([destinationGroupId, leftAt])
}

model WaMemberEvent {
  id                 String    @id @default(cuid())
  destinationGroupId String
  memberHash         String
  type               String // JOIN | LEAVE (left on their own) | KICK (removed by an admin)
  source             String // WEBHOOK | SNAPSHOT
  // For LEAVE/KICK: when that stint began (null if unknown), for tenure metrics.
  memberJoinedAt     DateTime?
  createdAt          DateTime  @default(now())

  destinationGroup DestinationGroup @relation(fields: [destinationGroupId], references: [id], onDelete: Cascade)

  @@index([destinationGroupId, createdAt])
  @@index([destinationGroupId, memberHash, createdAt])
}

model WaGroupSnapshot {
  id                 String   @id @default(cuid())
  destinationGroupId String
  memberCount        Int
  createdAt          DateTime @default(now())

  destinationGroup DestinationGroup @relation(fields: [destinationGroupId], references: [id], onDelete: Cascade)

  @@index([destinationGroupId, createdAt])
}

// ── Automatic Shopee product search (per niche) ─────────────────────────────

model ShopeeHunter {
  id            String @id @default(cuid())
  nicheId       String @unique
  sourceGroupId String @unique // the niche's virtual SHOPEE source group

  // OFF | PREVIEW (find, never send) | APPROVAL (to the approval queue) |
  // AUTO (send) | AUTO_BEST (send when score >= autoMinScore, else queue)
  mode String @default("OFF")

  keywords         String  @default("") @db.Text // one per line
  forbiddenWords   String  @default("") @db.Text // one per line
  minPrice         Float?
  maxPrice         Float?
  minRating        Float   @default(4.5)
  minSales         Int     @default(100)
  minCommissionPct Float   @default(0)
  minDiscountPct   Float   @default(15)
  minScore         Int     @default(60)
  autoMinScore     Int     @default(80)
  officialOnly     Boolean @default(false)

  intervalHours  Int @default(3) // how often to search
  dailyLimit     Int @default(12) // offers per day (sent or queued)
  minIntervalMin Int @default(20) // minutes between two offers
  quietStart     Int @default(23) // Brasília hour, no sending from…
  quietEnd       Int @default(7) // …until this hour

  useCoupons Boolean @default(true) // only matters while coupons are on globally

  lastRunAt      DateTime?
  lastRunSummary Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  niche       Niche             @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  sourceGroup SourceGroup       @relation(fields: [sourceGroupId], references: [id], onDelete: Cascade)
  candidates  HunterCandidate[]
}

model ShopeeProduct {
  id              String   @id @default(cuid())
  itemId          BigInt
  shopId          BigInt
  name            String
  imageUrl        String?  @db.Text
  productLink     String?  @db.Text
  offerLink       String?  @db.Text
  shopName        String?
  isOfficial      Boolean  @default(false)
  ratingStar      Float?
  sales           Int?
  commissionPct   Float?
  lastPrice       Float
  lastPriceMax    Float?
  lastDiscountPct Float?
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  prices     ShopeePricePoint[]
  candidates HunterCandidate[]

  @@unique([shopId, itemId])
}

model ShopeePricePoint {
  id          String   @id @default(cuid())
  productId   String
  price       Float
  discountPct Float?
  createdAt   DateTime @default(now())

  product ShopeeProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model HunterCandidate {
  id             String    @id @default(cuid())
  hunterId       String
  productId      String
  keyword        String
  price          Float
  originalPrice  Float?
  discountPct    Float? // effective discount used for the decision
  // Normalized title, to spot the same product sold by many shops.
  signature      String?
  discountSource String // HISTORY (vs our own price history) | ANNOUNCED (Shopee's own %)
  score          Int
  scoreDetail    Json?
  // PREVIEW | READY (waiting for a sending slot) | QUEUED (in the approval
  // queue) | SENT | EXPIRED (got stale before a slot opened)
  status         String
  offerId        String?
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  hunter  ShopeeHunter  @relation(fields: [hunterId], references: [id], onDelete: Cascade)
  product ShopeeProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([hunterId, status, createdAt])
  @@index([productId, createdAt])
  @@index([signature, decidedAt])
}

// Shopee coupons learned from the monitored Telegram channels (lib/coupons.ts)
model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  discountType String // FIXED | PERCENT
  value        Float
  maxDiscount  Float?
  minSpend     Float?
  validUntil   DateTime?
  status       String    @default("ACTIVE") // ACTIVE | EXPIRED | EXHAUSTED
  endReason    String?
  endedAt      DateTime?
  sources      Json? // last channels that posted it: [{ id, name, at }]
  sourceCount  Int       @default(1)
  mentions     Int       @default(1)
  usedCount    Int       @default(0)
  sample       String?   @db.Text
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())

  @@index([status])
}
