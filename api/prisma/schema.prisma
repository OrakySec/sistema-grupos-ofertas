// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DestinationType {
  TELEGRAM
  WHATSAPP
}

enum MediaType {
  NONE
  PHOTO
  VIDEO
  DOCUMENT
}

enum OfferStatus {
  PENDING
  APPROVED
  REJECTED
  SENT
  FAILED
}

enum DeliveryStatus {
  SUCCESS
  FAILED
}

model SourceGroup {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique
  name       String
  username   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Multiple SourceGroups can share one Niche (e.g. two Telegram channels
  // feeding the same public catalog/mockup/footer). Destination routing stays
  // per-SourceGroup regardless — see SourceGroupDestination below.
  nicheId String?
  niche   Niche?   @relation(fields: [nicheId], references: [id], onDelete: SetNull)

  offers       Offer[]
  destinations SourceGroupDestination[]
}

model Niche {
  id   String  @id @default(cuid())
  name String
  slug String? @unique // null = not yet exposed on the public offers site

  // null falls back to the global Setting of the same purpose. The 5 mockup*
  // fields are treated as an all-or-nothing group by the API (see
  // routes/niches.ts): either every one is set (custom template) or every one
  // is null (use the bundled default template + coordinates).
  footerText         String?  @db.Text
  mlOwnListUrl       String?
  mockupTemplatePath String?
  mockupBoxLeft      Int?
  mockupBoxTop       Int?
  mockupBoxRight     Int?
  mockupBoxBottom    Int?
  mockupCornerRadius Int?
  createdAt          DateTime @default(now())

  sourceGroups SourceGroup[]
}

model DestinationGroup {
  id        String          @id @default(cuid())
  name      String
  type      DestinationType
  chatId    String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  deliveryLogs  DeliveryLog[]
  sourceGroups  SourceGroupDestination[]
}

model SourceGroupDestination {
  sourceGroupId      String
  destinationGroupId String

  sourceGroup      SourceGroup      @relation(fields: [sourceGroupId], references: [id], onDelete: Cascade)
  destinationGroup DestinationGroup @relation(fields: [destinationGroupId], references: [id], onDelete: Cascade)

  @@id([sourceGroupId, destinationGroupId])
}

model Offer {
  id               String      @id @default(cuid())
  sourceGroupId    String
  telegramMessageId BigInt
  text             String?     @db.Text
  mediaType        MediaType   @default(NONE)
  mediaLocalPath   String?
  mediaCaption     String?     @db.Text
  senderName       String?
  status           OfferStatus @default(PENDING)
  originalDate     DateTime
  createdAt        DateTime    @default(now())
  reviewedAt       DateTime?
  sentAt           DateTime?
  processingLog    Json?

  sourceGroup  SourceGroup   @relation(fields: [sourceGroupId], references: [id])
  deliveryLogs DeliveryLog[]

  @@unique([telegramMessageId, sourceGroupId])
}

model DeliveryLog {
  id                 String         @id @default(cuid())
  offerId            String
  destinationGroupId String
  status             DeliveryStatus
  errorMessage       String?
  sentAt             DateTime       @default(now())

  offer            Offer            @relation(fields: [offerId], references: [id])
  destinationGroup DestinationGroup @relation(fields: [destinationGroupId], references: [id])
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model ShortUrl {
  code        String   @id
  originalUrl String   @db.Text
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  clickLogs   ShortUrlClick[]
}

model ShortUrlClick {
  id        String   @id @default(cuid())
  code      String
  createdAt DateTime @default(now())

  shortUrl  ShortUrl @relation(fields: [code], references: [code], onDelete: Cascade)
}
